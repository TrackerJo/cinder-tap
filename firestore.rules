rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /businesses/{businessId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }
    match /businessProfiles/{businessId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['name','address','phone','website'])
        && request.resource.data.keys().hasOnly(['name','address','phone','website'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.address is list && request.resource.data.address.size() <= 20
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 80
        && request.resource.data.website is string && request.resource.data.website.size() <= 200;
      allow delete: if signedIn() && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    match /businessReviews/{businessId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reviewLinks'])
        && request.resource.data.reviewLinks is map
        && request.resource.data.reviewLinks.keys().hasOnly(['google', 'yelp'])
        && (!('google' in request.resource.data.reviewLinks) ||
          (request.resource.data.reviewLinks.google is string && request.resource.data.reviewLinks.google.size() <= 2048 && request.resource.data.reviewLinks.google.matches('https://.*')))
        && (!('yelp' in request.resource.data.reviewLinks) ||
          (request.resource.data.reviewLinks.yelp is string && request.resource.data.reviewLinks.yelp.size() <= 2048 && request.resource.data.reviewLinks.yelp.matches('https://.*')));
      allow delete: if signedIn() && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    match /receipts/{receiptId} {
      // Random receipt IDs are bearer links. The collection cannot be browsed publicly.
      allow get: if resource.data.published == true || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && request.resource.data.receipt is map && request.resource.data.published == true;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
